# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/sunriovistas"

# ─────────────────────────────────────────────
# NextAuth
# ─────────────────────────────────────────────
# Public URL of the site (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"
# Randomly generated secret — run: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"

# ─────────────────────────────────────────────
# Google OAuth (for Sign in with Google)
# Create at https://console.cloud.google.com/apis/credentials
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─────────────────────────────────────────────
# Facebook OAuth (for Sign in with Facebook)
# Create at https://developers.facebook.com/apps
# ─────────────────────────────────────────────
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# ─────────────────────────────────────────────
# Apple OAuth (for Sign in with Apple)
# Requires Apple Developer account + Services ID
# See: https://next-auth.js.org/providers/apple
# ─────────────────────────────────────────────
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# ─────────────────────────────────────────────
# Gmail SMTP (for transactional emails)
# Use a Gmail App Password — NOT your account password
# Generate at: https://myaccount.google.com/apppasswords
# ─────────────────────────────────────────────
GMAIL_USER="youremail@gmail.com"
GMAIL_APP_PASSWORD="your-gmail-app-password"
EMAIL_FROM="SunRioVistas <youremail@gmail.com>"
# Admin email that receives new booking alerts
ADMIN_EMAIL="admin@sunriovistas.com"

# ─────────────────────────────────────────────
# Stripe (for payment processing)
# Keys at: https://dashboard.stripe.com/apikeys
# Webhook secret from: https://dashboard.stripe.com/webhooks
# ─────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ─────────────────────────────────────────────
# Google Drive (for image storage)
# Create OAuth2 credentials at: https://console.cloud.google.com
# Scope needed: https://www.googleapis.com/auth/drive.file
# FOLDER_ID: the Drive folder ID where images are stored
# ─────────────────────────────────────────────
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
GOOGLE_DRIVE_REFRESH_TOKEN=""
GOOGLE_DRIVE_FOLDER_ID=""

# ─────────────────────────────────────────────
# App (public vars exposed to the browser)
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
